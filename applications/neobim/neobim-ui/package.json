{
  "name": "neobim-ui",
  "version": "0.0.0",
  "private": true,
  "description": "NeoBIM's visual frontend (ui-neobim design system + layout/pages harvested from platform-neobim/apps/auth), wired to this platform's existing Ory Hydra/Kratos identity instead of NeoBIM's own Better Auth provider. See docs/07-applications/neobim-ui.md.",
  "type": "module",
  "scripts": {
    "sync:ui-css": "cp ../../../ui/packages/ui/styles/globals.css src/app/vendor-globals.css",
    "predev": "npm run sync:ui-css",
    "prebuild": "npm run sync:ui-css",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "@aec-craft/ui": "file:../../../ui/packages/ui",
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "openid-client": "^6.8.4",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0"
  }
}
