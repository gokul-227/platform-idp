#!/usr/bin/env bash
# =============================================================================
# Enterprise Identity Platform — Platform CLI Orchestrator
# =============================================================================
# Main script wrapper for managing the local development environment lifecycle.
# Usage: ./automation/platform <command> [args]
# =============================================================================

set -euo pipefail

# ─── Variables ───────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
COMPOSE_DIR="${PROJECT_ROOT}/deployment/docker/compose"
COMPOSE_CMD=(
  docker compose
  -f "${COMPOSE_DIR}/docker-compose.yml"
)
COMPOSE_FULL_CMD=(
  "${COMPOSE_CMD[@]}"
  -f "${COMPOSE_DIR}/docker-compose.observability.yml"
)

# Colors
RESET="\033[0m"
BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"

# ─── Loggers ──────────────────────────────────────────────────────────────────
log() {
  printf "${BOLD}${CYAN}[EIP]${RESET} %s\n" "$1"
}

success() {
  printf "${BOLD}${GREEN}[✓]${RESET} %s\n" "$1"
}

warn() {
  printf "${BOLD}${YELLOW}[!]${RESET} %s\n" "$1"
}

error() {
  printf "${BOLD}${RED}[✗]${RESET} %s\n" "$1" >&2
}

# ─── Help ─────────────────────────────────────────────────────────────────────
show_help() {
  printf "\n${BOLD}${BLUE}Enterprise Identity Platform Local CLI${RESET}\n"
  printf "Usage: ./platform <command> [options]\n\n"
  printf "${BOLD}Commands:${RESET}\n"
  printf "  ${CYAN}up${RESET}          Start the local developer platform stack\n"
  printf "  ${CYAN}up-full${RESET}     Start the platform plus observability stack\n"
  printf "  ${CYAN}down${RESET}        Stop the platform services\n"
  printf "  ${CYAN}restart${RESET}     Restart all platform services\n"
  printf "  ${CYAN}destroy${RESET}     Stop and destroy all containers and volumes\n"
  printf "  ${CYAN}status${RESET}      Show container status\n"
  printf "  ${CYAN}health${RESET}      Verify health of platform services\n"
  printf "  ${CYAN}logs${RESET}        Stream logs from all services\n"
  printf "  ${CYAN}shell${RESET}       Open shell in container (e.g. ./platform shell kratos)\n"
  printf "  ${CYAN}backup${RESET}      Backup database content and storage files\n"
  printf "  ${CYAN}restore${RESET}     Restore database content from snapshot\n"
  printf "  ${CYAN}sync${RESET}        Synchronize the YAML application registry\n"
  printf "  ${CYAN}doctor${RESET}      Check prerequisites and diagnose common errors\n"
  printf "\n"
}

# ─── Commands ─────────────────────────────────────────────────────────────────
cmd_up() {
  log "Spinning up platform infrastructure..."
  "${COMPOSE_CMD[@]}" up -d
  success "Platform infrastructure launched."
  cmd_health
}

cmd_up_full() {
  log "Spinning up platform infrastructure with observability..."
  "${COMPOSE_FULL_CMD[@]}" up -d
  success "Full platform infrastructure launched."
  cmd_health
}

cmd_down() {
  log "Stopping platform services..."
  "${COMPOSE_FULL_CMD[@]}" down
  success "Services stopped."
}

cmd_restart() {
  cmd_down
  cmd_up
}

cmd_destroy() {
  warn "WARNING: This will destroy all volumes and platform databases!"
  read -p "Are you sure? Type 'yes' to proceed: " -r confirm
  if [ "${confirm}" = "yes" ]; then
    log "Destroying platform volumes and containers..."
    "${COMPOSE_CMD[@]}" down -v --remove-orphans
    success "Platform destroyed."
  else
    log "Action cancelled."
  fi
}

cmd_status() {
  "${COMPOSE_FULL_CMD[@]}" ps
}

cmd_health() {
  log "Checking health of Ory services..."
  local services=("kratos" "hydra" "keto" "oathkeeper")
  for s in "${services[@]}"; do
    if ${COMPOSE_CMD} ps "$s" --format json | grep -q "running"; then
      success "Service $s is running."
    else
      error "Service $s is NOT running."
    fi
  done
}

cmd_logs() {
  "${COMPOSE_FULL_CMD[@]}" logs -f --tail=100 "$@"
}

cmd_shell() {
  if [ $# -lt 1 ]; then
    error "Please specify a service. Example: ./platform shell kratos"
    exit 1
  fi
  local service=$1
  shift
  "${COMPOSE_CMD[@]}" exec "${service}" sh "$@"
}

cmd_backup() {
  log "Creating backup of all platform databases..."
  local backup_dir="${PROJECT_ROOT}/backups"
  mkdir -p "${backup_dir}"
  local timestamp
  timestamp=$(date +%Y%m%d%H%M%S)

  "${PROJECT_ROOT}/automation/backup/backup.sh" "${backup_dir}/${timestamp}"

  success "Backups written to ${backup_dir}."
}

cmd_restore() {
  if [ $# -lt 1 ]; then
    error "Please specify a backup timestamp. Example: ./platform restore 20260715140000"
    exit 1
  fi
  local timestamp=$1
  local backup_dir="${PROJECT_ROOT}/backups"

  "${PROJECT_ROOT}/automation/backup/restore.sh" "${backup_dir}/${timestamp}"

  success "Restore operation complete."
}

cmd_sync() {
  log "Syncing Application Registry..."

  if docker ps --format '{{.Names}}' | grep -q '^app-registry$'; then
    response="$(curl -sf -X POST "http://localhost:8080/api/v1/sync" || true)"
    if [ -n "${response}" ]; then
      success "Registry synced via app-registry service."
      printf "%s\n" "${response}"
      return
    fi
    warn "App registry container is running but sync API failed; falling back to CLI."
  fi

  if [ -d "${PROJECT_ROOT}/platform/app-registry/.venv" ]; then
    (
      cd "${PROJECT_ROOT}/platform/app-registry"
      HYDRA_ADMIN_URL="${HYDRA_ADMIN_URL:-http://localhost:4445}" \
      REGISTRY_PATH="${REGISTRY_PATH:-${PROJECT_ROOT}/registry/apps}" \
      PLATFORM_ENV=local \
      uv run app-registry-cli sync
    )
    success "Registry synced via local CLI."
    return
  fi

  error "App registry dependencies are not installed. Run: cd platform/app-registry && uv sync --all-groups"
  exit 1
}

cmd_doctor() {
  log "Checking local requirements..."
  command -v docker >/dev/null 2>&1 || { error "Docker is not installed."; exit 1; }
  command -v git >/dev/null 2>&1 || { error "Git is not installed."; exit 1; }
  success "All local requirements satisfied."
}

# ─── Router ───────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

case "$1" in
  up) cmd_up ;;
  up-full) cmd_up_full ;;
  down) cmd_down ;;
  restart) cmd_restart ;;
  destroy) cmd_destroy ;;
  status) cmd_status ;;
  health) cmd_health ;;
  logs) shift; cmd_logs "$@" ;;
  shell) shift; cmd_shell "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  sync) cmd_sync ;;
  doctor) cmd_doctor ;;
  *) show_help ;;
esac
