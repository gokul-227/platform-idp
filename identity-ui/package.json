{
  "name": "neobim-identity-ui",
  "version": "0.0.0",
  "private": true,
  "description": "NeoBIM Identity Platform — a renderer for Ory Kratos/Hydra self-service flows, running alongside the existing auth-ui on a separate path prefix. Contains no authentication logic of its own; Kratos/Hydra remain the identity engine. See docs/10-reference/neobim-plugin-architecture-proposal.md.",
  "type": "module",
  "scripts": {
    "sync:ui-css": "cp ../../ui/packages/ui/styles/globals.css app/vendor-globals.css",
    "predev": "npm run sync:ui-css",
    "prebuild": "npm run sync:ui-css",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "@aec-craft/ui": "file:../../../ui/packages/ui",
    "@base-ui/react": "^1.5.0",
    "@ory/client-fetch": "^1.22.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0"
  }
}
