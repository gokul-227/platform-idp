{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/schemas/app-registry.schema.json",
  "title": "Application Registry Definition",
  "description": "YAML schema for OAuth2/OIDC client definitions synced to Ory Hydra",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "client_name",
    "redirect_uris",
    "grant_types",
    "scope"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "client_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "redirect_uris": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "post_logout_redirect_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "grant_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "authorization_code",
          "client_credentials",
          "refresh_token",
          "implicit"
        ]
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "client_secret_env_var": {
      "type": "string",
      "minLength": 1
    },
    "token_endpoint_auth_method": {
      "type": "string",
      "enum": [
        "client_secret_basic",
        "client_secret_post",
        "client_secret_jwt",
        "private_key_jwt",
        "none"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
