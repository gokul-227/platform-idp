{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform Global Configuration",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "organization": { "type": "string" },
        "display_name": { "type": "string" },
        "support_email": { "type": "string", "format": "email" }
      },
      "required": ["name", "version", "organization"]
    },
    "urls": {
      "type": "object",
      "properties": {
        "base": { "type": "string" },
        "kratos_public": { "type": "string" },
        "kratos_admin": { "type": "string" },
        "hydra_public": { "type": "string" },
        "hydra_admin": { "type": "string" },
        "keto_read": { "type": "string" },
        "keto_write": { "type": "string" },
        "oathkeeper_proxy": { "type": "string" },
        "admin_ui": { "type": "string" }
      },
      "required": ["base", "kratos_public", "hydra_public", "keto_read", "oathkeeper_proxy"]
    },
    "authentication": {
      "type": "object",
      "properties": {
        "registration": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "require_verification": { "type": "boolean" }
          }
        },
        "login": {
          "type": "object",
          "properties": {
            "default_aal": { "type": "string", "enum": ["aal1", "aal2"] },
            "admin_required_aal": { "type": "string", "enum": ["aal1", "aal2"] }
          }
        },
        "mfa": {
          "type": "object",
          "properties": {
            "totp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "webauthn": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "passkeys": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  },
  "required": ["platform", "urls", "authentication"]
}
