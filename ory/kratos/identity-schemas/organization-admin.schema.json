{
  "$id": "https://platform.yourdomain.com/schemas/organization-admin.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization Administrator Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["traits"],
  "properties": {
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "organization"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "webauthn": { "identifier": true },
              "code": { "identifier": true, "via": "email" }
            },
            "recovery": { "via": "email" },
            "verification": { "via": "email" }
          }
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "first": { "type": "string", "minLength": 1, "maxLength": 50 },
            "last": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "role"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "role": { "const": "admin" }
          }
        }
      }
    }
  }
}
