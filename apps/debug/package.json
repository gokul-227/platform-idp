    "lint": "ultracite check",
    "start": "next start -p 3202"
  },
  "dependencies": {
    "@aec-craft/platform-id-client-nextjs": "workspace:*",
    "@aec-craft/ui": "^0.3.2",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "catalog:",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:"
  }
}
