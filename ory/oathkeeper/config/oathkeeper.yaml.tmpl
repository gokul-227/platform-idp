# =============================================================================
# Ory Oathkeeper — Production Configuration
# =============================================================================
# Identity-Aware Proxy (IAP) configuration.
# Intercepts, authenticates, authorizes, and mutates all incoming traffic.
#
# Documentation: https://www.ory.sh/docs/oathkeeper/reference/configuration
# =============================================================================

serve:
  proxy:
    port: 4455
    host: 0.0.0.0
    # Entrypoint of the entire cluster. Handles external HTTP requests.
  api:
    port: 4456
    host: 0.0.0.0
    # Oathkeeper management API (rules, health) - keep internal.

# ─── Access Rules Repository ──────────────────────────────────────────────────
# Rules determine how requests are routed and checked.
errors:
  fallback:
    - json
  handlers:
    json:
      enabled: true
      config:
        verbose: false
    redirect:
      enabled: true
      config:
        to: ${PLATFORM_BASE_URL}/auth/login
        when:
          - error:
              - unauthorized
              - forbidden
            request:
              header:
                accept:
                  - text/html

# ─── Access Control Rules Location ────────────────────────────────────────────
access_rules:
  repositories:
    - file:///etc/config/oathkeeper/rules/access-rules.json

# ─── Authenticators ───────────────────────────────────────────────────────────
authenticators:
  # ── Noop (No authentication needed for public routes) ──────────────────────
  noop:
    enabled: true

  # ── Anonymous (Fallback for unauthenticated traffic) ──────────────────────
  anonymous:
    enabled: true
    config:
      subject: guest

  # ── Cookie Session (Authenticates session cookie via Kratos) ───────────────
  cookie_session:
    enabled: true
    config:
      check_session_url: http://kratos:4433/sessions/whoami
      preserve_path: true
      preserve_query: true
      subject_from: identity.id
      extra_from: identity.traits

  # ── OAuth2 Introspection (Introspects access tokens via Hydra) ────────────
  oauth2_introspection:
    enabled: true
    config:
      # Hydra v2's admin-port introspection endpoint is under /admin — the
      # unprefixed path (also accepted by the admin port) 307-redirects to
      # it with a malformed empty-host Location
      # ("http:///admin/oauth2/introspect"), which breaks this authenticator
      # outright since Oathkeeper's HTTP client can't follow that. Confirmed
      # directly: POSTing to the unprefixed path returns that redirect;
      # /admin/oauth2/introspect works correctly.
      introspection_url: http://hydra:4445/admin/oauth2/introspect
      pre_authorization:
        enabled: false
      # token_from must pick exactly one source (schema rejects header +
      # query_parameter together); subject_from/extra_from aren't valid keys
      # here (unlike cookie_session's schema) — Hydra's introspection
      # response already provides `sub`/`ext` without needing to be told.
      token_from:
        header: Authorization

  # ── JWT (Validates external signed JWTs) ──────────────────────────────────
  jwt:
    enabled: true
    config:
      jwks_urls:
        - http://hydra:4444/.well-known/jwks.json
      token_from:
        header: Authorization
      # subject_from isn't a valid key here — the JWT authenticator always
      # uses the token's own `sub` claim as the subject.

# ─── Authorizers ──────────────────────────────────────────────────────────────
authorizers:
  # ── Allow (Passes through after authentication) ───────────────────────────
  allow:
    enabled: true

  # ── Deny (Explicitly blocks requests) ─────────────────────────────────────
  deny:
    enabled: true

  # ── Remote JSON (Queries Keto for ReBAC check) ────────────────────────────
  remote_json:
    enabled: true
    config:
      remote: http://keto:4466/relation-tuples/check
      # .Match doesn't exist on the template context (*authn.
      # AuthenticationSession) — regex capture groups from the matched
      # rule's URL live under .MatchContext.RegexpCaptureGroups. Confirmed
      # directly: `.Match` errors with "can't evaluate field Match in type
      # *authn.AuthenticationSession". access-rules.json's
      # platform-api-rules URL is `http://<.*>/api/v1/apps/<.*>` — index 0
      # is the host wildcard, index 1 is the path.
      payload: |
        {
          "namespace": "Resource",
          "object": "{{ printIndex .MatchContext.RegexpCaptureGroups 1 }}",
          "relation": "view",
          "subject_id": "{{ .Subject }}"
        }

# ─── Mutators ─────────────────────────────────────────────────────────────────
mutators:
  # ── Noop (Passes headers as-is) ───────────────────────────────────────────
  noop:
    enabled: true

  # ── Header (Injects session data into custom HTTP headers) ────────────────
  header:
    enabled: true
    config:
      headers:
        X-User-ID: "{{ .Subject }}"
        X-User-Email: "{{ .Extra.email }}"
        X-User-Organization: "{{ with .Extra.organization }}{{ .id }}{{ end }}"

  # ── ID Token (Signs and injects JWT for downstreams) ──────────────────────
  id_token:
    enabled: true
    config:
      issuer_url: ${PLATFORM_BASE_URL}
      jwks_url: file:///etc/config/oathkeeper/config/jwks.json
      ttl: 5m
      claims: |
        {
          "sub": "{{ .Subject }}",
          "email": "{{ .Extra.email }}",
          "organization": "{{ .Extra.organization }}",
          "role": "{{ .Extra.organization.role }}"
        }

# ─── Observability ────────────────────────────────────────────────────────────
log:
  level: info
  format: json

tracing:
  provider: otel
  providers:
    otlp:
      insecure: true
      sampling:
        sampling_ratio: 0.1
      # This Oathkeeper version does not expand ${VAR} here — hardcoded,
      # matching ory/keto/config/keto.yaml's identical fix.
      # Scheme-less host:port — the schema rejects a URI here. 4318 = the
      # collector's OTLP/HTTP receiver: Ory's exporters speak OTLP-over-HTTP,
      # so pointing at the gRPC port (4317) silently delivers nothing (both
      # found live during the first observability bring-up, AI_HANDOFF §1.13).
      server_url: otel-collector:4318
