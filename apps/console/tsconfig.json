{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // @aec-craft/ui ships raw .tsx compiled by the consumer, and its own
    // source does not satisfy exactOptionalPropertyTypes (the platform
    // monorepo's shared tsconfig does not set it). skipLibCheck does not
    // cover source files, so the flag has to be off here until ui is fixed
    // upstream and released. App code in src/ already satisfies it.
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
