root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{go}]
indent_style = tab
indent_size = 4

[*.{py}]
indent_size = 4

[*.{java}]
indent_size = 4

[*.{xml,pom}]
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.{toml}]
indent_size = 2

[*.{tf,tfvars}]
indent_size = 2

[*.{helm,tpl}]
indent_size = 2

[*.{sql}]
indent_size = 2
