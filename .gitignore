# =============================================================================
# Enterprise Identity Platform — .gitignore
# =============================================================================

# ─── Secrets & Credentials ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─── Generated at runtime, never source ──────────────────────────────────────
/backups/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
.secrets/
vault-token
.vault-token

# ─── OS Generated ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── IDE & Editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.vim
.nvim/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.iml

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─── Build Artifacts ─────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.output/
coverage/
*.lcov
.nyc_output/
storybook-static/

# ─── Go ──────────────────────────────────────────────────────────────────────
bin/
vendor/
*.test
*.out
go.sum.bak

# This repo has no Go code, but the generic "vendor/" ignore above would
# otherwise swallow the one real, actively-used directory under vendor/: the
# pinned Ory kratos-selfservice-ui-node submodule (see .gitmodules), wired as
# the auth-ui Compose service.
!vendor/kratos-selfservice-ui-reference/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.env/
.eggs/
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
*.prof

# ─── Terraform ───────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars
!*.tfvars.example
# The per-environment sizing files below are safe to commit — no secrets
# in them (region/CIDR/instance-type only; passwords are always passed via
# a separate, git-ignored *.secrets.tfvars or TF_VAR_* env vars — see
# terraform/environments/{aws,gcp}/*.tfvars's own header comment).
!terraform/environments/aws/dev.tfvars
!terraform/environments/aws/staging.tfvars
!terraform/environments/aws/prod.tfvars
!terraform/environments/gcp/dev.tfvars
!terraform/environments/gcp/staging.tfvars
!terraform/environments/gcp/prod.tfvars
*.backend.hcl
!*.backend.hcl.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.tfplan
.terraform.tfstate.lock.info

# ─── Helm ────────────────────────────────────────────────────────────────────
charts/*.tgz
helm/charts/*/charts/*.tgz

# ─── Docker ──────────────────────────────────────────────────────────────────
.docker/

# ─── Kubernetes ──────────────────────────────────────────────────────────────
kubeconfig
*.kubeconfig
kube-config.yaml

# ─── Database ────────────────────────────────────────────────────────────────
*.sql.bak
*.dump
*.sqlite
*.sqlite3
pgdata/
redis-data/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
npm-debug.log
yarn-debug.log

# ─── Ory Specific ────────────────────────────────────────────────────────────
# Never commit Ory admin secrets or generated JWKs
ory/.jwks/
ory/hydra/.keys/
ory/kratos/courier-messages/
kratos-session.db
hydra.db

# ─── Observability ───────────────────────────────────────────────────────────
grafana-data/
prometheus-data/
loki-data/
tempo-data/

# ─── Platform CLI Build ───────────────────────────────────────────────────────
cli/dist/
cli/bin/
platform-cli

# ─── Testing ─────────────────────────────────────────────────────────────────
tests/results/
tests/reports/
tests/screenshots/
playwright-report/
test-results/
k6-results/

# ─── Temporary ───────────────────────────────────────────────────────────────
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.patch

# Generated by automation/database/seed/seed_enterprise_dataset.py — a
# result manifest of live-environment IDs, not source.
automation/database/seed/seed_result.json

# ─── PAUSED infrastructure/observability (temporary — see the latest ─────────
# implementation report's "Infrastructure pause" section) ────────────────────
# Work on Kubernetes/Helm/Terraform/cloud/observability is explicitly paused.
# None of these paths were tracked or staged in git at the time this was
# added (verified: `git status --short` showed zero entries under any of
# them, and this repo has zero commits total), so this blanket ignore is
# fully effective on its own — it is NOT a substitute for a real cleanup if
# any of these are ever staged/committed before the pause is lifted (see
# the report for why .gitignore alone cannot un-track an already-tracked
# file). Nothing here is deleted; remove this section (and the files stay
# exactly where they are) whenever this work resumes.
#
# This shadows the existing fine-grained Terraform secret-hygiene rules
# above (*.tfstate, *.tfvars, etc.) while paused — those become redundant,
# not wrong, and resume mattering the moment this section is removed.
deployment/kubernetes/
deployment/helm/
terraform/
observability/
