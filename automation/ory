#!/usr/bin/env bash
# Single entry point for platform lifecycle commands — replaces the 9
# separate ory-* wrapper scripts that used to sit at the repo root. Each
# subcommand is a thin delegation to the equivalent `make` target; see the
# Makefile for what actually runs. (Distinct from `automation/platform`, the
# older direct-Compose lifecycle CLI predating the Makefile — see that
# file's own header for why both exist.)
#
# Usage: ory <command> [args]        (or: automation/ory <command> [args])
#   install   Copy .env.example -> .env (if missing) and generate dev secrets
#   start     Start the platform (Ory + all platform services + auth-ui)
#   stop      Stop the platform, keep all data
#   restart   Stop then start
#   status    Show every running container in this platform's stack
#   health    Verify every component actually responds, not just "running"
#   logs      Tail logs from every service, or one: ory logs kratos
#   reset     Wipe DATA ONLY (identities/sessions/OAuth2 clients), fresh start
#   destroy   Remove every container/volume/network belonging to this project
#
# No root-level launcher exists — `ory` is already the config directory's
# name (ory/kratos, ory/hydra, ...). Run this directly: ./automation/ory start
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# //; s/^#//'
  exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

case "$cmd" in
  install)
    make setup-env
    if grep -q "CHANGE_ME" .env 2>/dev/null; then
      ./automation/setup/generate-secrets.sh .env
    fi
    echo "Ready. Run './automation/ory start' next."
    ;;
  start)   make up ;;
  stop)    make down ;;
  restart) make restart ;;
  status)  make status ;;
  health)  make health ;;
  logs)
    if [ $# -eq 0 ]; then make logs; else make "logs-$1"; fi
    ;;
  reset)   make reset ;;
  destroy) make destroy ;;
  *) usage ;;
esac
