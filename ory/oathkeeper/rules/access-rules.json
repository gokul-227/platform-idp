[
  {
    "id": "kratos-public-rules",
    "upstream": {
      "preserve_host": true,
      "strip_path": "/.ory/kratos/public",
      "url": "http://kratos:4433"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "url": "http://<.*>/.ory/kratos/public/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "hydra-public-rules",
    "upstream": {
      "preserve_host": true,
      "url": "http://hydra:4444"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/oauth2/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "hydra-well-known-rules",
    "upstream": {
      "preserve_host": true,
      "url": "http://hydra:4444"
    },
    "match": {
      "methods": [
        "GET"
      ],
      "url": "http://<[^/]+>/.well-known/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "hydra-userinfo-rules",
    "upstream": {
      "preserve_host": true,
      "url": "http://hydra:4444"
    },
    "match": {
      "methods": [
        "GET",
        "POST"
      ],
      "url": "http://<.*>/userinfo"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "hydra-orchestrator-rules",
    "upstream": {
      "preserve_host": true,
      "url": "http://auth-service:8083"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/hydra/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "auth-ui-root-rule",
    "upstream": {
      "preserve_host": true,
      "url": "http://identity-ui:3000"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<[^/]+>/auth"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "auth-ui-rules",
    "upstream": {
      "preserve_host": true,
      "url": "http://identity-ui:3000"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/auth/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "auth-ui-legacy-rules",
    "upstream": {
      "preserve_host": true,
      "strip_path": "/auth-legacy",
      "url": "http://auth-ui:3000"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/auth-legacy/<.*>"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "platform-api-rules",
    "upstream": {
      "preserve_host": true,
      "strip_path": "/api/v1/apps",
      "url": "http://app-registry:8080"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "url": "http://<.*>/api/v1/apps/<.*>"
    },
    "authenticators": [
      {
        "handler": "oauth2_introspection"
      }
    ],
    "authorizer": {
      "handler": "remote_json"
    },
    "mutators": [
      {
        "handler": "header"
      }
    ],
    "errors": [
      {
        "handler": "json"
      }
    ]
  },
  {
    "id": "console-relation-tuples-rule",
    "upstream": {
      "preserve_host": true,
      "url": "http://console-api:8086"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "DELETE",
        "OPTIONS"
      ],
      "url": "http://<.*>/api/v1/relation-tuples"
    },
    "authenticators": [
      {
        "handler": "cookie_session"
      }
    ],
    "authorizer": {
      "handler": "remote_json",
      "config": {
        "remote": "http://authorization-service:8090/api/v1/authorize",
        "payload": "{\n  \"subject_id\": \"{{ .Subject }}\",\n  \"organization_id\": \"platform\",\n  \"relation\": \"admin\"\n}"
      }
    },
    "mutators": [
      {
        "handler": "header"
      }
    ],
    "errors": [
      {
        "handler": "json"
      }
    ]
  },
  {
    "id": "superset-oidc-callback",
    "upstream": {
      "preserve_host": true,
      "strip_path": "/apps/superset",
      "url": "http://superset:8088"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/apps/<superset>/oauth-authorized/hydra"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
    "id": "superset-application",
    "upstream": {
      "preserve_host": true,
      "strip_path": "/apps/superset",
      "url": "http://superset:8088"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "url": "http://<.*>/apps/<superset>/<.*>"
    },
    "authenticators": [
      {
        "handler": "cookie_session"
      }
    ],
    "authorizer": {
      "handler": "remote_json"
    },
    "mutators": [
      {
        "handler": "header"
      }
    ]
  },
  {
    "id": "airflow-oidc-callback",
    "upstream": {
      "preserve_host": true,
      "url": "http://airflow:8080"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "url": "http://<.*>/apps/<airflow>/auth/oauth-authorized/hydra"
    },
    "authenticators": [
      {
        "handler": "noop"
      }
    ],
    "authorizer": {
      "handler": "allow"
    },
    "mutators": [
      {
        "handler": "noop"
      }
    ]
  },
  {
