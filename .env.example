# =============================================================================
# Enterprise Identity Platform — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For production: use a secrets manager (Vault, AWS Secrets Manager, GCP SM)
# See: docs/10-reference/security.md
# =============================================================================

# ─── Platform ────────────────────────────────────────────────────────────────
PLATFORM_ENV=local
PLATFORM_VERSION=dev
PLATFORM_LOG_LEVEL=debug
PLATFORM_LOG_FORMAT=json
PLATFORM_BASE_URL=http://localhost:4455

# ─── Ory Kratos ──────────────────────────────────────────────────────────────
# Host-side ports. Change these (and the matching *_URL below) if 4433/4434
# etc. already belong to something else on your machine — Compose never
# assumes these are free.
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
KRATOS_DATABASE_URL=postgres://kratos:kratos_secret@localhost:5432/kratos?sslmode=disable
# IMPORTANT: Generate with: automation/setup/generate-secrets.sh
# Must be 32+ bytes, base64 encoded
KRATOS_SECRETS_COOKIE=CHANGE_ME_32_BYTES_BASE64_ENCODED_SECRET_HERE
# Unlike every other secret on this page, this must be EXACTLY 32 raw
# characters (used directly as an AES-256 key) — base64 encoding it (44+
# chars) fails Kratos's schema validation at startup. generate-secrets.sh
# already produces the right format for this one.
KRATOS_SECRETS_CIPHER=CHANGE_ME_EXACTLY_32_RAW_CHARACTERS
# Courier / Email sending DSN. No credentials in the URI — go-mail refuses
# to send AUTH over a plaintext connection even with disable_starttls=true,
# and Mailhog doesn't require auth anyway.
KRATOS_COURIER_SMTP_URL=smtp://mailhog:1025/?disable_starttls=true

# ─── Ory Hydra ───────────────────────────────────────────────────────────────
HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_DATABASE_URL=postgres://hydra:hydra_secret@localhost:5433/hydra?sslmode=disable
# IMPORTANT: Generate with: automation/setup/generate-secrets.sh
HYDRA_SECRETS_SYSTEM=CHANGE_ME_32_BYTES_SYSTEM_SECRET_HERE
HYDRA_SECRETS_COOKIE=CHANGE_ME_32_BYTES_COOKIE_SECRET_HERE
HYDRA_PAIRWISE_SALT=CHANGE_ME_pairwise_salt

# ─── Ory Keto ────────────────────────────────────────────────────────────────
KETO_READ_PORT=4466
KETO_WRITE_PORT=4467
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467
KETO_DATABASE_URL=postgres://keto:keto_secret@localhost:5434/keto?sslmode=disable

# ─── Ory Oathkeeper ──────────────────────────────────────────────────────────
OATHKEEPER_PROXY_PORT=4455
OATHKEEPER_API_PORT=4456
OATHKEEPER_PROXY_URL=http://localhost:4455
OATHKEEPER_API_URL=http://localhost:4456

# ─── PostgreSQL (per-service, isolated) ──────────────────────────────────────
# Each service's actual DSN (user/password/db name) is hardcoded in the Compose
# files, not built from separate HOST/DB/USER/PASSWORD variables — only the
# host-published port is actually configurable via .env.
POSTGRES_KRATOS_PORT=5432
POSTGRES_HYDRA_PORT=5433
POSTGRES_KETO_PORT=5434
POSTGRES_PLATFORM_PORT=5435

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_TLS_ENABLED=false

# ─── Upstream Authentication UI ──────────────────────────────────────────────
AUTH_UI_PORT=3000
# Browser-facing base URL for the auth UI — keep this in sync with
# AUTH_UI_PORT above if you override it (used by the config-render init
# container to fill in Kratos/Hydra CORS allow-lists; see docs/adr/ADR-0013).
AUTH_UI_BASE_URL=http://localhost:3000

# ─── NeoBIM Identity UI (applications/neobim-identity-ui) ────────────────────
# Runs alongside auth-ui above — see identity-ui-rules in
# ory/oathkeeper/rules/access-rules.json for which prefix routes here.
IDENTITY_UI_PORT=3010
COOKIE_SECRET=CHANGE_ME_auth_ui_cookie_secret
CSRF_COOKIE_SECRET=CHANGE_ME_auth_ui_csrf_secret

# Self-registration is OFF by default across every environment — Kratos's
# registration.enabled config key reads this directly (see
# ory/kratos/config/kratos.yaml.tmpl and deployment/docker/compose/docker-compose.yml's
# config-render service). Set to true to let new users sign themselves up;
# the registration page/flow/code all still exist either way, this only
# gates whether Kratos will actually mint a registration flow.
SELF_REGISTRATION_ENABLED=false

# Comma-separated identity emails that identity-ui/lib/admin-emails.ts treats
# as admins for login-page UI EMPHASIS only (which methods the staged
# login flow highlights after "Continue") — this never grants or restricts
# real authentication/authorization, Kratos itself remains the sole source
# of truth for that.
ADMIN_EMAILS=

# identity-ui/middleware.ts's admin-console access gate — the real
# Organization#admin object id it checks. Was a hardcoded "platform"
# literal in source; same value by default, now configurable.
PLATFORM_ORGANIZATION_ID=platform

# ─── Social Login Providers ──────────────────────────────────────────────────
# Google
SOCIAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SOCIAL_GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# Microsoft
SOCIAL_MICROSOFT_CLIENT_ID=your-microsoft-client-id
SOCIAL_MICROSOFT_CLIENT_SECRET=CHANGE_ME_microsoft_client_secret
SOCIAL_MICROSOFT_TENANT=common

# ─── Email Provider ───────────────────────────────────────────────────────────
# Provider: smtp | ses | sendgrid | mailgun | resend
EMAIL_PROVIDER=smtp

# SMTP (for local dev, points to Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@platform.local
SMTP_FROM_NAME=Identity Platform
SMTP_TLS_ENABLED=false

# SendGrid (production alternative)
SENDGRID_API_KEY=CHANGE_ME_sendgrid_api_key

# AWS SES
SES_REGION=us-east-1
SES_FROM_ADDRESS=noreply@yourdomain.com

# Resend
RESEND_API_KEY=CHANGE_ME_resend_api_key

# Mailgun
MAILGUN_API_KEY=CHANGE_ME_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com

# ─── SMS Provider ─────────────────────────────────────────────────────────────
# Provider: twilio | aws-sns
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=CHANGE_ME_twilio_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# AWS SNS
SNS_REGION=us-east-1

# ─── Secret Manager ───────────────────────────────────────────────────────────
# Provider: dotenv | vault | aws-secrets-manager | gcp-secret-manager
SECRETS_PROVIDER=dotenv

# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGE_ME_vault_token
VAULT_NAMESPACE=
VAULT_MOUNT_PATH=secret

# AWS Secrets Manager
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# GCP Secret Manager
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# ─── Storage ──────────────────────────────────────────────────────────────────
# Provider: local | s3 | gcs
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage

# AWS S3
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PREFIX=identity-platform/

# GCS
GCS_BUCKET=your-gcs-bucket
GCS_PREFIX=identity-platform/

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=identity-platform

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

LOKI_PORT=3100
LOKI_URL=http://localhost:3100

TEMPO_PORT=3200
TEMPO_ZIPKIN_PORT=9411

# ─── Application Registry Service ────────────────────────────────────────────
APP_REGISTRY_PORT=8080
# Keep in sync with APP_REGISTRY_PORT above — see AUTH_UI_BASE_URL's comment.
APP_REGISTRY_BASE_URL=http://localhost:8080
APP_REGISTRY_REGISTRY_PATH=./registry/apps
APP_REGISTRY_DRY_RUN=false

# ─── Tenant Service ───────────────────────────────────────────────────────────
TENANT_SERVICE_PORT=8081
TENANT_SERVICE_JWT_SECRET=CHANGE_ME_tenant_service_jwt_secret

# ─── Hooks Service ────────────────────────────────────────────────────────────
HOOKS_SERVICE_PORT=8082
HOOKS_SERVICE_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ─── Auth Service ─────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=8083

# ─── Email Service ────────────────────────────────────────────────────────────
EMAIL_SERVICE_PORT=8084

# ─── Notification Service ─────────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=8085

# ─── Application OIDC client secrets (optional plugins) ────────────────────
# Used when deployment/docker/compose/docker-compose.applications.yml is
# enabled. Run automation/setup/generate-secrets.sh to populate these in .env.
SUPERSET_OIDC_CLIENT_SECRET=CHANGE_ME_superset_oidc_secret
SUPERSET_SECRET_KEY=CHANGE_ME_superset_flask_secret_key
AIRFLOW_OIDC_CLIENT_SECRET=CHANGE_ME_airflow_oidc_secret
# See docs/07-applications/neobim-ui.md — additive-only, does not touch
# any existing service.
NEOBIM_OIDC_CLIENT_SECRET=CHANGE_ME_neobim_ui_oidc_secret

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_LIFESPAN=720h
SESSION_IDLE_TIMEOUT=30m

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW=1h

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_PASSKEYS_ENABLED=true
FEATURE_MAGIC_LINK_ENABLED=true
FEATURE_MFA_REQUIRED=false
FEATURE_SOCIAL_LOGIN_ENABLED=true
FEATURE_SAML_ENABLED=false
FEATURE_DEVICE_FLOW_ENABLED=true
FEATURE_MULTI_TENANCY_ENABLED=true
