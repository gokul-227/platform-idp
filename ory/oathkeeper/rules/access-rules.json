    "upstream": {
      "preserve_host": true,
      "url": "http://airflow:8080"
    },
    "match": {
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "url": "http://<.*>/apps/<airflow>/<.*>"
    },
    "authenticators": [
      {
        "handler": "cookie_session"
      }
    ],
    "authorizer": {
      "handler": "remote_json"
    },
    "mutators": [
      {
        "handler": "header"
      }
    ]
  }
]
