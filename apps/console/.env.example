# Ory admin endpoints. The defaults match the repo-root compose.yaml, so local
# development needs none of these set. These ports have no authentication;
# only this app should be able to reach them.
KRATOS_ADMIN_URL=http://localhost:4434
HYDRA_ADMIN_URL=http://localhost:4445

# Public ports, used for the overview's readiness probes.
KRATOS_PUBLIC_URL=http://localhost:4433

# Where the sidebar's "Sign-in app" link points.
ID_APP_URL=http://localhost:3200

# This console as an OAuth2 client of its own Hydra: the operator's own token
# for /admin/*, client_credentials for the organization reads. Set all of
# PLATFORM_API_URL and this pair, or the tenancy pages say the console is not
# registered. `scripts/seed-platform-client.ts` prints the pair.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# This repository's own database, beside Ory's three. The audit log is the first
# table in it; a later slice shares it and keeps its own drizzle journal.
DATABASE_URL=postgres://id_app_role:dev@127.0.0.1:5434/identity

# Shared secret for /api/internal/audit, which staff.guard.ts calls to record a
# refused access because the edge runtime cannot reach Postgres. Same value apps/id
# takes. Unset means that capture is off, not open.
# AUDIT_WEBHOOK_SECRET=
