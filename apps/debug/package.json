{
  "name": "@aec-craft/debug",
  "version": "0.0.0",
  "description": "Local-only example app for @aec-craft/platform-id-client-nextjs. A registered OAuth client of buildOS ID, wired the way any consumer would be, so a change to the adapter can be seen working before it is published.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "tsc --noEmit",
