{
  "$id": "https://platform.yourdomain.com/schemas/enterprise-user.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enterprise User Identity",
  "description": "Complete identity schema for enterprise users with full authentication method support",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email Address",
          "description": "Primary email address, used for login and communication",
          "minLength": 3,
          "maxLength": 254,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              },
              "webauthn": {
                "identifier": true
              },
              "totp": {
                "account_name": true
              },
              "code": {
                "identifier": true,
                "via": "email"
              }
            },
            "recovery": {
              "via": "email"
            },
            "verification": {
              "via": "email"
            }
          }
        },
        "username": {
          "type": "string",
          "title": "Username",
          "description": "Unique username (no spaces, 3-30 characters)",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "object",
          "title": "Full Name",
          "properties": {
            "first": {
              "type": "string",
              "title": "First Name",
              "minLength": 1,
              "maxLength": 50
            },
            "last": {
              "type": "string",
              "title": "Last Name",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "phone": {
          "type": "string",
          "title": "Phone Number",
          "description": "Phone number in E.164 format (e.g. +15551234567)",
          "pattern": "^\\+[1-9]\\d{1,14}$",
          "ory.sh/kratos": {
            "credentials": {
              "code": {
                "identifier": true,
                "via": "sms"
              }
            }
          }
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "title": "Profile Picture URL",
          "description": "URL to the user's profile picture"
        },
        "locale": {
          "type": "string",
          "title": "Preferred Locale",
          "description": "BCP 47 language tag (e.g. en-US, de-DE)",
          "default": "en",
          "examples": ["en", "en-US", "de-DE", "fr-FR"]
        },
        "timezone": {
          "type": "string",
          "title": "Timezone",
          "description": "IANA timezone name (e.g. America/New_York)",
          "default": "UTC"
        },
        "organization": {
          "type": "object",
          "title": "Organization",
          "description": "Primary organization membership",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "title": "Organization ID"
            },
            "name": {
              "type": "string",
              "title": "Organization Name"
            },
            "role": {
              "type": "string",
              "title": "Role in Organization",
              "enum": ["platform_admin", "org_admin", "org_member", "viewer", "api_client"]
            },
            "department": {
              "type": "string",
              "title": "Department"
            },
            "job_title": {
              "type": "string",
              "title": "Job Title"
            }
          }
        },
        "consent": {
          "type": "object",
          "title": "User Consent",
          "properties": {
            "terms_accepted": {
              "type": "boolean",
              "title": "Terms of Service Accepted",
              "default": false
            },
            "terms_accepted_at": {
              "type": "string",
              "format": "date-time",
              "title": "Terms Accepted At"
            },
            "marketing_emails": {
              "type": "boolean",
              "title": "Marketing Email Consent",
              "default": false
            }
          }
        },
        "metadata": {
          "type": "object",
          "title": "Custom Metadata",
          "description": "Application-specific metadata (not visible to user)",
          "additionalProperties": true
        },
        "status": {
          "type": "string",
          "title": "Account Status",
          "enum": ["active", "suspended", "pending_verification", "deactivated"],
          "default": "active"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
