# Ory endpoints. The defaults in src/lib/env.ts match the repo-root
# compose.yaml, so local development needs none of these set.

# Kratos, as reached from the Next server.
KRATOS_PUBLIC_URL=http://localhost:4433

# Kratos public URL as reached from the user's browser. Diverges from
# KRATOS_PUBLIC_URL once this app runs inside the compose network.
NEXT_PUBLIC_KRATOS_BROWSER_URL=http://localhost:4433

# Hydra. The admin port is never exposed publicly.
HYDRA_ADMIN_URL=http://localhost:4445

# Kratos admin, for one call: closing your own account. See
# src/lib/account.deletion.ts for what keeps that narrow.
KRATOS_ADMIN_URL=http://localhost:4434

# The resource server holding a profile row per identity, told before the
# identity goes. Leave both empty for a deployment with nothing downstream:
# the call is skipped rather than failing.
PLATFORM_API_URL=
IDENTITY_WEBHOOK_SECRET=

# This app as an OAuth2 client of its own Hydra, so the tenancy pages call the
# platform API as the signed-in person. `scripts/seed-platform-client.ts` prints
# the pair; all three of PLATFORM_API_URL and these must be set or the pages
# show the way in instead of a list. APP_URL and HYDRA_PUBLIC_URL default to the
# local ports.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# APP_URL=http://localhost:3200
# HYDRA_PUBLIC_URL=http://localhost:4444

# Who may create an account for themselves; the console's admin creation is not
# bound by it. `true` opens registration and ignores the list; anything else leaves
# it closed, so a typo cannot open it, and an empty list then admits nobody.
REGISTRATION_OPEN=false
REGISTRATION_ALLOWED_DOMAINS=neobim.ai,neobim.eu

# Origins a Back link this app draws may point at: the console, and anywhere
# else a guard sends someone here from. Separate from Kratos's own
# allowed_return_urls, which governs only its redirects. Unset drops the link
# rather than following an unvetted origin.
ALLOWED_RETURN_ORIGINS=http://localhost:3201

# This repository's own database, beside Ory's three. The audit log is the first
# table in it; a later slice shares it and keeps its own drizzle journal.
# A slice that ever moves onto its own instance sets AUDIT_DATABASE_URL (or its
# own <SLICE>_DATABASE_URL), which is read first.
DATABASE_URL=postgres://id_app_role:dev@127.0.0.1:5434/identity

# Shared secret the audit intake routes require as X-Audit-Token, one value for
# both receivers, matching ory/kratos/kratos.local.yml. Unset, the route 404s and
# records nothing rather than accepting an unauthenticated write.
# AUDIT_WEBHOOK_SECRET=

# Shared secret the Hydra refresh hook presents as X-Refresh-Hook-Token. Unset,
# the route 404s and Hydra fails the refresh rather than reissuing unchecked
# claims, so a deployment that forgets it is loud rather than permissive.
REFRESH_HOOK_SECRET=dev-only-refresh-hook-secret
